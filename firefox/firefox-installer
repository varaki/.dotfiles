#!/usr/bin/env bash

MOZILLA_KEYRING_PATH="/etc/apt/keyrings/packages.mozilla.org.asc"
MOZILLA_SOURCES_PATH="/etc/apt/sources.list.d/mozilla.sources"
MOZILLA_PREFERENCES_PATH="/etc/apt/preferences.d/mozilla.pref"

# System-wide policies, picked up by any Firefox install (deb or tarball)
FF_POLICIES_PATH="/etc/firefox/policies/policies.json"

# --elx: Mozilla tarball in /opt (covered by Ubuntu's AppArmor userns profile)
FIREFOX_TARBALL_URL="https://download.mozilla.org/?product=firefox-latest-ssl&os=linux64&lang=en-US"
FIREFOX_INSTALL_DIR="/opt/firefox"
NO_SNAP_PREFERENCES_PATH="/etc/apt/preferences.d/no-snap.pref"

FF_POLICIES=$(
    cat <<EOF
{
    "policies": {
        "Extensions": {
            "Install": [
                "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
                "https://addons.mozilla.org/firefox/downloads/latest/darkreader/latest.xpi",
                "https://addons.mozilla.org/firefox/downloads/latest/surfingkeys_ff/latest.xpi",
                "https://addons.mozilla.org/firefox/downloads/latest/bitwarden-password-manager/latest.xpi"
            ]
        }
    }
}
EOF
)

MOZILLA_REPO_SOURCES=$(
    cat <<EOF
Types: deb
URIs: https://packages.mozilla.org/apt/
Suites: mozilla
Components: main
Signed-By: /etc/apt/keyrings/packages.mozilla.org.asc
EOF
)

MOZILLA_REPO_PREFERENCES=$(
    cat <<EOF
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOF
)

NO_SNAP_PREFERENCES=$(
    cat <<EOF
Explanation: Block Ubuntu's snap-transitional firefox package
Package: firefox
Pin: release *
Pin-Priority: -1

Explanation: Block snapd from all origins (incl. Debian trixie)
Package: snapd
Pin: release *
Pin-Priority: -1
EOF
)

FIREFOX_DESKTOP_ENTRY=$(
    cat <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Firefox
GenericName=Web Browser
Comment=Browse the World Wide Web
Exec=${FIREFOX_INSTALL_DIR}/firefox %u
Icon=${FIREFOX_INSTALL_DIR}/browser/chrome/icons/default/default128.png
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=firefox
Actions=new-window;new-private-window;profile-manager;

[Desktop Action new-window]
Name=New Window
Exec=${FIREFOX_INSTALL_DIR}/firefox --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=${FIREFOX_INSTALL_DIR}/firefox --private-window %u

[Desktop Action profile-manager]
Name=Profile Manager
Exec=${FIREFOX_INSTALL_DIR}/firefox -P
EOF
)

PSD_CONFIG=$(
    cat <<EOF
USE_OVERLAYFS="yes"
BROWSERS="firefox"
USE_BACKUPS="no"
BACKUP_LIMIT=0
EOF
)

removeMozillaRepo() {
    rm -rf "${MOZILLA_KEYRING_PATH}" \
        "${MOZILLA_SOURCES_PATH}" \
        "${MOZILLA_PREFERENCES_PATH}"
}

uninstallPackages() {
    sudo apt purge --autoremove firefox firefox-esr profile-sync-daemon --yes
}

setupMozillaRepo() {
    wget -q https://packages.mozilla.org/apt/repo-signing-key.gpg -O- >"${MOZILLA_KEYRING_PATH}"
    echo "${MOZILLA_REPO_SOURCES}" >${MOZILLA_SOURCES_PATH}
    echo "${MOZILLA_REPO_PREFERENCES}" >${MOZILLA_PREFERENCES_PATH}
}

blockSnap() {
    echo "${NO_SNAP_PREFERENCES}" >"${NO_SNAP_PREFERENCES_PATH}"
}

installFirefoxTarball() {
    local tmp_dir user_home user_group
    tmp_dir="$(mktemp -d)"
    user_home="/home/${SUDO_USER}"
    user_group="$(id -gn "${SUDO_USER}")"

    echo "Downloading Firefox tarball"
    if ! wget -q -O "${tmp_dir}/firefox.tar.xz" "${FIREFOX_TARBALL_URL}" ||
        ! tar -xJf "${tmp_dir}/firefox.tar.xz" -C "${tmp_dir}"; then
        echo "Failed to download or extract Firefox"
        rm -rf "${tmp_dir}"
        exit 1
    fi

    rm -rf "${FIREFOX_INSTALL_DIR}"
    mv "${tmp_dir}/firefox" "${FIREFOX_INSTALL_DIR}"
    rm -rf "${tmp_dir}"
    # Owned by the user so Firefox can update itself
    chown -R "${SUDO_USER}:${user_group}" "${FIREFOX_INSTALL_DIR}"

    echo "Creating launcher and symlink"
    sudo --user "${SUDO_USER}" mkdir -p "${user_home}/.local/bin" "${user_home}/.local/share/applications"
    sudo --user "${SUDO_USER}" ln -sf "${FIREFOX_INSTALL_DIR}/firefox" "${user_home}/.local/bin/firefox"
    echo "${FIREFOX_DESKTOP_ENTRY}" | sudo --user "${SUDO_USER}" tee "${user_home}/.local/share/applications/firefox.desktop" >/dev/null
}

installPackages() {
    if ${ELX}; then
        echo "Installing packages"
        apt update
        apt install systemd-container profile-sync-daemon --yes
        installFirefoxTarball
        return
    fi

    if ! command -v psd >&/dev/null || ! command -v firefox >&/dev/null; then
        echo "Installing packages"
        ${MOZILLA_REPO} && esr="" || esr="-esr"
        apt update
        apt install firefox${esr} systemd-container profile-sync-daemon --yes
    fi
}

profileSetup() {
    if command -v psd >&/dev/null; then
        # Stop services (systemd-container must be installed)
        machinectl shell "${SUDO_USER}"@ /bin/systemctl --user disable --now psd.service psd-resync.timer psd-resync.service >&/dev/null
    fi

    local sleeptime=10

    echo "Cleaning up firefox profiles"
    rm -rf /home/${SUDO_USER}/.config/mozilla

    local ff_bin="firefox"
    if ${ELX}; then
        # Policies are managed by ELX, leave them untouched
        ff_bin="${FIREFOX_INSTALL_DIR}/firefox"
    else
        echo "Setting up extensions via ${FF_POLICIES_PATH}"
        mkdir -p "$(dirname "${FF_POLICIES_PATH}")"
        echo "${FF_POLICIES}" >"${FF_POLICIES_PATH}"
    fi

    echo "Starting firefox in headless mode and wait for ${sleeptime} seconds"
    sudo --user ${SUDO_USER} --login "${ff_bin}" --headless >&/dev/null &
    sleep ${sleeptime}

    echo "Stopping firefox"
    pkill -f "firefox.* --headless"

    local profile_to_remove="$(find /home/${SUDO_USER}/.config/mozilla/firefox/ -maxdepth 1 -type d -name "*.default" ! -name "*.default-esr*" ! -name "*.default-release*")"
    local profile_to_sync="$(find /home/${SUDO_USER}/.config/mozilla/firefox/ -maxdepth 1 -type d -name "*.default-esr*" -o -name "*.default-release*")"

    rm -rf ${profile_to_remove}

    echo "Copying custom config to ${profile_to_sync}"
    sudo --user ${SUDO_USER} cp -rv user.js ${profile_to_sync}

}

configurePSD() {
    # Create config
    sudo --user ${SUDO_USER} mkdir -p /home/${SUDO_USER}/.config/psd
    echo "${PSD_CONFIG}" | sudo --user ${SUDO_USER} tee /home/${SUDO_USER}/.config/psd/psd.conf >&/dev/null

    # Create sudoers rule
    echo "${SUDO_USER} ALL=(ALL) NOPASSWD: /usr/bin/psd-overlay-helper" >/etc/sudoers.d/psd-overlay-helper

    # Enable services (systemd-container must be installed)
    machinectl shell "${SUDO_USER}"@ /bin/systemctl --user enable --now psd.service psd-resync.timer psd-resync.service >&/dev/null
}

usage() {
    cat <<EOF
Usage: sudo $(basename "$0") [OPTIONS]

Install Firefox with profile-sync-daemon, extensions and custom user.js.
WARNING: removes ~/.config/mozilla (all existing Firefox profiles).

Options:
  -m, --enable-mozilla-repo  Install Firefox from Mozilla's APT repository
                             (default: firefox-esr from the distribution)
      --elx                  ELX laptops: install Mozilla's tarball to
                             ${FIREFOX_INSTALL_DIR}, block snap/snapd via APT pinning
                             and leave Firefox policies untouched
  -h, --help                 Show this help and exit

--elx and --enable-mozilla-repo are mutually exclusive.
EOF
}

MOZILLA_REPO=false
ELX=false

while [ $# -ne 0 ]; do
    case "${1}" in
    -m | --enable-mozilla-repo)
        MOZILLA_REPO=true
        ;;
    --elx)
        ELX=true
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        echo "Invalid parameter: ${1}" >&2
        usage >&2
        exit 1
        ;;
    esac
    shift
done

if [ "$(whoami)" != "root" ]; then
    echo "This script must be run with sudo"
    exit 1
fi

if ${MOZILLA_REPO} && ${ELX}; then
    echo "--elx and --enable-mozilla-repo are mutually exclusive (Puppet removes the Mozilla repo on ELX)"
    exit 1
fi

if ${ELX}; then
    echo "ELX mode: removing Mozilla repo leftovers and blocking snap"
    removeMozillaRepo
    blockSnap
elif ${MOZILLA_REPO}; then
    echo "Enabling Mozilla's firefox repository"
    setupMozillaRepo
fi

echo "Checking packages..."
uninstallPackages
installPackages

echo "Setting up firefox..."
profileSetup

echo "Configuring profile-sync-daemon..."
configurePSD
